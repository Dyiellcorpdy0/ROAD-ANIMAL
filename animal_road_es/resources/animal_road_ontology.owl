<?xml version="1.0"?>
<rdf:RDF xmlns="http://example.org/animal_road#"
     xml:base="http://example.org/animal_road"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#">
    <owl:Ontology rdf:about="http://example.org/animal_road"/>

    <owl:Class rdf:about="http://example.org/animal_road#Animal"/>
    <owl:Class rdf:about="http://example.org/animal_road#Moose">
        <rdfs:subClassOf rdf:resource="http://example.org/animal_road#Animal"/>
    </owl:Class>
    <owl:Class rdf:about="http://example.org/animal_road#Deer">
        <rdfs:subClassOf rdf:resource="http://example.org/animal_road#Animal"/>
    </owl:Class>
    <owl:Class rdf:about="http://example.org/animal_road#Boar">
        <rdfs:subClassOf rdf:resource="http://example.org/animal_road#Animal"/>
    </owl:Class>
    <owl:Class rdf:about="http://example.org/animal_road#Dog">
        <rdfs:subClassOf rdf:resource="http://example.org/animal_road#Animal"/>
    </owl:Class>
</rdf:RDF>
